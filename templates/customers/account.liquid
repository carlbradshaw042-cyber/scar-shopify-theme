<section class="section-pad page-top"><h1>Account</h1><p>{{ customer.name }} · <a href="{{ routes.account_logout_url }}">Sign out</a></p><h2>Orders</h2>{% paginate customer.orders by 20 %}{% for order in customer.orders %}<p><a href="{{ order.customer_url }}">{{ order.name }}</a> — {{ order.created_at | date: '%B %d, %Y' }} — {{ order.total_price | money }}</p>{% else %}<p>No orders yet.</p>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}<h2>Addresses</h2><p>{{ customer.default_address | format_address }}</p><a href="{{ routes.account_addresses_url }}">Manage addresses</a></section>
