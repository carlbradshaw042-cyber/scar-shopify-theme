<section class="narrow page-top section-pad"><h1>Create account</h1>{% form 'create_customer', class: 'contact-form' %}{{ form.errors | default_errors }}<label for="FirstName">First name</label><input id="FirstName" name="customer[first_name]" autocomplete="given-name"><label for="LastName">Last name</label><input id="LastName" name="customer[last_name]" autocomplete="family-name"><label for="RegisterEmail">Email</label><input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required><label for="RegisterPassword">Password</label><input id="RegisterPassword" type="password" name="customer[password]" required><button class="button">Create</button>{% endform %}</section>
