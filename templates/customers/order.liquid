<section class="section-pad page-top"><h1>{{ order.name }}</h1><p>{{ order.created_at | date: '%B %d, %Y' }}</p>{% for line_item in order.line_items %}<p>{{ line_item.title }} × {{ line_item.quantity }} — {{ line_item.final_line_price | money }}</p>{% endfor %}<p><strong>Total {{ order.total_price | money }}</strong></p><a href="{{ routes.account_url }}">Back to account</a></section>
