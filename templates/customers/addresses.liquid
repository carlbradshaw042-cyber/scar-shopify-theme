<section class="section-pad page-top"><h1>Addresses</h1>{% for address in customer.addresses %}<article>{{ address | format_address }}<form method="post" action="/account/addresses/{{ address.id }}"><input type="hidden" name="_method" value="delete"><button type="submit">Delete</button></form></article>{% endfor %}<a href="{{ routes.account_url }}">Back to account</a></section>
