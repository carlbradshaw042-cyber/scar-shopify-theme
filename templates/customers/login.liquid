<section class="narrow page-top section-pad"><h1>Account</h1>{% form 'customer_login', class: 'contact-form' %}{{ form.errors | default_errors }}<label for="CustomerEmail">Email</label><input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required><label for="CustomerPassword">Password</label><input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required><button class="button">Sign in</button><a href="{{ routes.account_register_url }}">Create account</a>{% endform %}</section>
