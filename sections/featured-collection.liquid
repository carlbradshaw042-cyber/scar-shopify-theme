{% assign featured_collection = section.settings.collection | default: collections.all %}
<section class="section-pad featured" style="--columns:{{ section.settings.columns }};--fit:{{ section.settings.image_fit }};--section-top:{{ section.settings.padding_top }}px;--section-bottom:{{ section.settings.padding_bottom }}px">
  <header class="section-head"><h2>{{ section.settings.heading }}</h2>{% if section.settings.show_view_all %}<a href="{{ featured_collection.url }}">{{ section.settings.view_all_label }} ↗</a>{% endif %}</header>
  <div class="product-grid">{% for product in featured_collection.products limit: section.settings.limit %}{% render 'product-card', product: product, image_ratio: section.settings.image_ratio, image_fit: section.settings.image_fit %}{% else %}<p class="empty-state">No products are available yet. Select a collection or add products to the catalog.</p>{% endfor %}</div>
</section>
{% schema %}{"name":"New arrivals grid","settings":[{"type":"text","id":"heading","default":"New Arrivals","label":"Heading"},{"type":"collection","id":"collection","label":"Collection","info":"Uses the All collection when blank."},{"type":"range","id":"limit","min":2,"max":24,"step":2,"default":12,"label":"Product count"},{"type":"range","id":"columns","min":2,"max":5,"step":1,"default":4,"label":"Wide desktop columns"},{"type":"select","id":"image_ratio","default":"4 / 5","label":"Image ratio","options":[{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"},{"value":"3 / 4","label":"Tall portrait"}]},{"type":"select","id":"image_fit","default":"cover","label":"Image fit","options":[{"value":"cover","label":"Crop to fill"},{"value":"contain","label":"Fit without cropping"}]},{"type":"checkbox","id":"show_view_all","default":true,"label":"Show View all link"},{"type":"text","id":"view_all_label","default":"View all","label":"View all label"},{"type":"range","id":"padding_top","min":32,"max":160,"step":8,"default":80,"unit":"px","label":"Top spacing"},{"type":"range","id":"padding_bottom","min":32,"max":160,"step":8,"default":96,"unit":"px","label":"Bottom spacing"}],"presets":[{"name":"New arrivals grid"}]}{% endschema %}
