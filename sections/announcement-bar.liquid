{% if section.settings.show and section.settings.text != blank %}
  <aside class="announcement" aria-label="Announcement"><p>{{ section.settings.text }}</p></aside>
{% endif %}
{% schema %}{"name":"Announcement bar","settings":[{"type":"checkbox","id":"show","default":true,"label":"Show announcement"},{"type":"text","id":"text","default":"PREORDER OPEN — SHIPPING UPDATES VIA EMAIL","label":"Text"},{"type":"url","id":"link","label":"Link"}]}{% endschema %}
