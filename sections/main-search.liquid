<section class="section-pad page-top"><h1>{{ 'general.search' | t }}</h1><form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchInput">{{ 'general.search' | t }}</label><input id="SearchInput" name="q" type="search" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}"><button class="button">Search</button></form>{% if search.performed %}{% paginate search.results by 12 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article class="search-result"><a href="{{ item.url }}"><h2>{{ item.title }}</h2><p>{{ item.content | strip_html | truncate: 150 }}</p></a></article>{% endif %}{% else %}<p>{{ 'general.no_results' | t }}</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Search","settings":[]}{% endschema %}
