<footer class="footer section-pad" style="--footer-logo-desktop:{{ section.settings.logo_width }}px;--footer-logo-mobile:{{ section.settings.logo_mobile_width }}px;--footer-logo-space:{{ section.settings.logo_spacing }}px">
  {% if section.settings.show_logo %}<a class="footer__brand footer__brand--{{ section.settings.logo_alignment }}" href="{{ routes.root_url }}">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 1600 | image_tag: widths: '240,500,900,1200,1600', alt: shop.name, loading: 'lazy' }}{% else %}<span>{{ shop.name }}</span>{% endif %}</a>{% endif %}
  <nav aria-label="Footer">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% if settings.instagram_url != blank %}<a href="{{ settings.instagram_url }}" rel="noopener" target="_blank">Instagram</a>{% endif %}{% if settings.tiktok_url != blank %}<a href="{{ settings.tiktok_url }}" rel="noopener" target="_blank">TikTok</a>{% endif %}</nav>
  {% if section.settings.show_newsletter %}{% form 'customer', class: 'footer-newsletter' %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="FooterEmail">{{ section.settings.newsletter_heading }}</label><div><input id="FooterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="Email address"><button type="submit">Join ↗</button></div>{% if form.posted_successfully? %}<p role="status">You’re on the list.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}{% endif %}
  <div class="footer__bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>{% if section.settings.show_payment_icons %}<div class="payment-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% endif %}<span>{{ powered_by_link }}</span></div>
</footer>
{% schema %}{"name":"Footer","settings":[{"type":"image_picker","id":"logo","label":"Footer logo"},{"type":"checkbox","id":"show_logo","default":true,"label":"Show footer logo"},{"type":"range","id":"logo_width","min":120,"max":1200,"step":20,"default":600,"unit":"px","label":"Desktop logo width"},{"type":"range","id":"logo_mobile_width","min":100,"max":400,"step":10,"default":260,"unit":"px","label":"Mobile logo width"},{"type":"select","id":"logo_alignment","default":"left","label":"Logo alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"logo_spacing","min":0,"max":100,"step":5,"default":60,"unit":"px","label":"Logo spacing"},{"type":"link_list","id":"menu","label":"Footer menu","info":"Add Contact, Sizing, and Shipping/returns links here."},{"type":"checkbox","id":"show_newsletter","default":false,"label":"Show footer newsletter"},{"type":"text","id":"newsletter_heading","default":"Join the list","label":"Newsletter heading"},{"type":"checkbox","id":"show_payment_icons","default":true,"label":"Show payment icons"}]}{% endschema %}
