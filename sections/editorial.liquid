{% if section.settings.show_section %}<section class="editorial editorial--{{ section.settings.image_alignment }}" style="--editorial-height:{{ section.settings.height }}vh;--editorial-top:{{ section.settings.padding_top }}px;--editorial-bottom:{{ section.settings.padding_bottom }}px">
  <picture class="editorial__media">{% if section.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">{% endif %}{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '600,1000,1600,2400', sizes: '100vw', loading: 'lazy', alt: section.settings.image.alt }}{% else %}<div class="editorial__placeholder">Select editorial photography</div>{% endif %}</picture>
  {% if section.settings.show_content %}<div class="editorial__content"><h2>{{ section.settings.heading }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.link_label }} ↗</a>{% endif %}</div>{% endif %}
</section>{% endif %}
{% schema %}{"name":"Editorial image","settings":[{"type":"checkbox","id":"show_section","default":true,"label":"Show section"},{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"checkbox","id":"show_content","default":true,"label":"Show content"},{"type":"text","id":"heading","default":"In focus","label":"Heading"},{"type":"textarea","id":"text","default":"A study in form, texture and movement.","label":"Short text"},{"type":"text","id":"link_label","default":"Discover","label":"Link label"},{"type":"url","id":"link","label":"Link"},{"type":"select","id":"image_alignment","default":"center","label":"Image alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"height","min":35,"max":80,"step":5,"default":60,"unit":"vh","label":"Section height"},{"type":"range","id":"padding_top","min":0,"max":120,"step":8,"default":0,"unit":"px","label":"Top spacing"},{"type":"range","id":"padding_bottom","min":0,"max":120,"step":8,"default":0,"unit":"px","label":"Bottom spacing"}],"presets":[{"name":"Editorial image"}]}{% endschema %}
