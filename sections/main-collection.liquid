<section class="section-pad page-top" style="--columns:{{ section.settings.columns }}">
  <header class="collection-head">{% if section.settings.show_image and collection.image != blank %}{{ collection.image | image_url: width: 2000 | image_tag: widths: '700,1200,1600,2000', sizes: '100vw', loading: 'eager', alt: collection.image.alt }}{% endif %}<p class="eyebrow">{{ collection.products_count }} products</p><h1>{{ collection.title }}</h1>{% if section.settings.show_description and collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</header>
  <form class="collection-tools" method="get"><details><summary>Filter</summary>{% for filter in collection.filters %}<fieldset><legend>{{ filter.label }}</legend>{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> {{ value.label }} ({{ value.count }})</label>{% endfor %}</fieldset>{% endfor %}<button class="button" type="submit">Apply</button></details><label for="SortBy">Sort <select id="SortBy" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></label></form>
  {% paginate collection.products by section.settings.page_size %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product, image_ratio: section.settings.image_ratio, image_fit: section.settings.image_fit %}{% else %}<p class="empty-state">No products match these filters.</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}
</section>
{% schema %}{"name":"Collection","settings":[{"type":"checkbox","id":"show_image","default":true,"label":"Show collection image"},{"type":"checkbox","id":"show_description","default":true,"label":"Show description"},{"type":"range","id":"page_size","min":4,"max":24,"step":2,"default":12,"label":"Products per page"},{"type":"range","id":"columns","min":2,"max":5,"step":1,"default":4,"label":"Desktop columns"},{"type":"select","id":"image_ratio","default":"4 / 5","label":"Image ratio","options":[{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"},{"value":"3 / 4","label":"Tall portrait"}]},{"type":"select","id":"image_fit","default":"cover","label":"Image fit","options":[{"value":"cover","label":"Crop to fill"},{"value":"contain","label":"Fit without cropping"}]}]}{% endschema %}
