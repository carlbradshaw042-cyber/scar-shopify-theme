<section class="narrow page-top section-pad"><h1>{{ page.title }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact', class: 'contact-form' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">Thanks. We’ll be in touch.</p>{% endif %}<label for="ContactName">Name</label><input id="ContactName" name="contact[name]" autocomplete="name"><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" required autocomplete="email"><label for="ContactBody">Message</label><textarea id="ContactBody" name="contact[body]" rows="8" required></textarea><button class="button">Send</button>{% endform %}</section>{% schema %}{"name":"Contact form","settings":[]}{% endschema %}
