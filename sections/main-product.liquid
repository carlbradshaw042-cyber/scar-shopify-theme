<section class="product" data-product-section data-section-id="{{ section.id }}">
  <div class="product__gallery" aria-label="Product media">
    {% for media in product.media %}<figure id="Media-{{ media.id }}" class="product__media">{% case media.media_type %}{% when 'image' %}{{ media | image_url: width: 2000 | image_tag: widths: '600,900,1200,1600,2000', sizes: '(min-width: 900px) 62vw, 100vw', loading: 'lazy', alt: media.alt }}{% when 'video' %}{{ media | video_tag: controls: true, image_size: '1200x' }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag }}{% endcase %}</figure>{% endfor %}
  </div>
  <div class="product__info">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ product.title }}</h1><div data-product-price>{% render 'price', product: product %}</div>
    {% form 'product', product, id: 'ProductForm', class: 'product-form', data-product-form: '' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
      {% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<fieldset class="variant-field"><legend>{{ option.name }}</legend><div class="variant-buttons">{% for value in option.values %}<input class="visually-hidden" type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option-position="{{ option.position }}"{% if option.selected_value == value %} checked{% endif %}><label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">{{ value }}</label>{% endfor %}</div></fieldset>{% endfor %}{% endunless %}
      <label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label><input class="quantity" id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
      {% assign shipping_message = section.settings.shipping_message | default: settings.shipping_date %}{% if shipping_message != blank %}<p class="shipping-note"><span></span>{{ shipping_message }}</p>{% endif %}
      <button class="button add-button" type="submit" name="add" data-add-button{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}><span data-add-text>{% if product.selected_or_first_available_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span><span data-selected-price>{{ product.selected_or_first_available_variant.price | money }}</span></button>
      {% if settings.show_dynamic_checkout %}<div class="dynamic-checkout">{{ form | payment_button }}</div>{% endif %}
    {% endform %}
    {% if settings.size_guide != blank or settings.size_chart_image != blank %}<button type="button" class="size-guide-trigger" data-size-guide-open>{{ 'products.size_guide' | t }}</button>{% endif %}
    <details class="product-detail" open><summary>Description <span>+</span></summary><div class="rte">{{ product.description }}</div></details>
    {% for block in section.blocks %}{% case block.type %}{% when 'details' %}<details class="product-detail" {{ block.shopify_attributes }}><summary>{{ block.settings.heading }} <span>+</span></summary><div class="rte">{{ block.settings.text }}</div></details>{% when 'shipping' %}{% if block.settings.message != blank %}<p class="shipping-note" {{ block.shopify_attributes }}><span></span>{{ block.settings.message }}</p>{% endif %}{% when 'metafield_details' %}{% if product.metafields.custom.product_details != blank %}<details class="product-detail" {{ block.shopify_attributes }}><summary>{{ block.settings.heading }} <span>+</span></summary><div class="rte">{{ product.metafields.custom.product_details | metafield_tag }}</div></details>{% endif %}{% endcase %}{% endfor %}
  </div>
  <script type="application/json" data-product-json>{{ product.variants | json }}</script>
</section>
{% if settings.size_guide != blank or settings.size_chart_image != blank %}<div class="size-guide drawer" data-size-guide aria-hidden="true"><button class="drawer__scrim" data-size-guide-close aria-label="{{ 'accessibility.close' | t }}"></button><aside class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="SizeGuideTitle"><header><h2 id="SizeGuideTitle">{{ 'products.size_guide' | t }}</h2><button class="icon-button" data-size-guide-close aria-label="{{ 'accessibility.close' | t }}">×</button></header>{% if settings.size_chart_image != blank %}{{ settings.size_chart_image | image_url: width: 1600 | image_tag: widths: '500,900,1200,1600', loading: 'lazy', alt: settings.size_chart_image.alt }}{% endif %}{% if settings.size_guide != blank %}<div class="rte">{{ settings.size_guide.content }}</div>{% endif %}</aside></div>{% endif %}
{% schema %}{"name":"Product information","settings":[{"type":"text","id":"eyebrow","default":"Product details","label":"Eyebrow"},{"type":"text","id":"shipping_message","label":"Preorder / shipping message","info":"Leave blank to use the global product setting."}],"blocks":[{"type":"details","name":"Expandable details","settings":[{"type":"text","id":"heading","default":"Materials & construction","label":"Heading"},{"type":"richtext","id":"text","label":"Details","info":"Add garment-specific weight, fiber, fit, construction, or production notes."}]},{"type":"shipping","name":"Shipping notice","settings":[{"type":"textarea","id":"message","label":"Message","info":"Set release-specific preorder or shipping information."}]},{"type":"metafield_details","name":"Product details metafield","settings":[{"type":"text","id":"heading","default":"Product details","label":"Heading"}]}],"max_blocks":8}{% endschema %}
