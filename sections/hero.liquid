{% if section.settings.show_hero %}<section class="hero" style="--shade:{{ section.settings.overlay | divided_by: 100.0 }};--hero-desktop:{{ section.settings.desktop_height }}vh;--hero-mobile:{{ section.settings.mobile_height }}vh">
  <picture class="hero__media">{% if section.settings.video != blank %}{{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}{% elsif section.settings.image != blank %}{% if section.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">{% endif %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '600,900,1200,1800,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}{% else %}<div class="hero__placeholder" role="img" aria-label="Select hero media in the theme editor">Select hero media</div>{% endif %}</picture>
  <div class="hero__content hero__content--{{ section.settings.alignment }}">
    {% if section.settings.show_logo and section.settings.logo != blank %}<div class="hero__logo hero__logo--{{ section.settings.logo_alignment }}" style="--hero-logo-desktop:{{ section.settings.logo_width }}px;--hero-logo-mobile:{{ section.settings.logo_mobile_width }}px;--hero-logo-space:{{ section.settings.logo_spacing }}px">{{ section.settings.logo | image_url: width: 1200 | image_tag: widths: '200,400,800,1200', alt: shop.name }}</div>{% elsif section.settings.heading != blank %}<h1>{{ section.settings.heading }}</h1>{% endif %}
    {% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}{% if section.settings.show_button and section.settings.button_label != blank %}<a class="button button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}
  </div>
</section>{% endif %}
{% schema %}{"name":"Compact hero","settings":[{"type":"checkbox","id":"show_hero","default":true,"label":"Show hero"},{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"video","id":"video","label":"Shopify-hosted video"},{"type":"image_picker","id":"logo","label":"Hero overlay logo"},{"type":"checkbox","id":"show_logo","default":true,"label":"Show hero logo"},{"type":"range","id":"logo_width","min":100,"max":700,"step":20,"default":300,"unit":"px","label":"Logo desktop width"},{"type":"range","id":"logo_mobile_width","min":80,"max":400,"step":20,"default":200,"unit":"px","label":"Logo mobile width"},{"type":"select","id":"logo_alignment","default":"left","label":"Logo alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"logo_spacing","min":0,"max":60,"step":4,"default":16,"unit":"px","label":"Logo spacing"},{"type":"text","id":"heading","default":"New season","label":"Heading / logo fallback"},{"type":"textarea","id":"subheading","default":"Essential forms, made with intent.","label":"Short subheading"},{"type":"checkbox","id":"show_button","default":false,"label":"Show button"},{"type":"text","id":"button_label","default":"Explore","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"alignment","default":"bottom-left","label":"Text alignment","options":[{"value":"bottom-left","label":"Bottom left"},{"value":"center","label":"Center"},{"value":"bottom-right","label":"Bottom right"}]},{"type":"range","id":"overlay","min":0,"max":70,"step":5,"default":20,"unit":"%","label":"Overlay strength"},{"type":"range","id":"desktop_height","min":30,"max":65,"step":5,"default":55,"unit":"vh","label":"Desktop height"},{"type":"range","id":"mobile_height","min":30,"max":55,"step":5,"default":45,"unit":"vh","label":"Mobile height"}],"presets":[{"name":"Compact hero"}]}{% endschema %}
