@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}

/* Independent brand marks keep their intrinsic proportions at every placement. */
.brand-logo__image {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  object-fit: contain;
}

.brand-logo__text {
  display: block;
  font-family: var(--heading);
  font-size: inherit;
  font-weight: 700;
  letter-spacing: -.09em;
  line-height: .8;
  text-transform: uppercase;
  white-space: nowrap;
}

.wordmark {
  width: min(var(--header-logo-width), 40vw);
  justify-self: center;
}

.wordmark--mobile { display: none; }
.site-header--logo-left .wordmark--desktop { justify-self: start; }
.site-header--logo-center .wordmark--desktop { justify-self: center; }
.site-header--logo-right .wordmark--desktop { justify-self: end; }

.drawer-logo {
  display: flex;
  width: min(var(--drawer-logo-width), 100%);
  margin-bottom: 18px;
  font-size: 44px;
}
.drawer-logo--left { align-self: flex-start; }
.drawer-logo--center { align-self: center; }
.drawer-logo--right { align-self: flex-end; }

.hero__logo {
  display: flex;
  width: min(var(--hero-logo-width), 100%);
  margin-bottom: clamp(24px, 4vw, 52px);
  font-size: clamp(70px, 12vw, 180px);
}
.hero__logo-align--left .hero__logo { align-self: flex-start; }
.hero__logo-align--center .hero__logo { align-self: center; }
.hero__logo-align--right .hero__logo { align-self: flex-end; }

.footer__brand {
  display: flex;
  width: min(var(--footer-logo-width), 100%);
  font-size: clamp(92px, 23vw, 360px);
}
.footer__brand--left { margin-right: auto; }
.footer__brand--center { margin-right: auto; margin-left: auto; }
.footer__brand--right { margin-left: auto; }

@media (max-width: 749px) {
  .wordmark--desktop { display: none; }
  .wordmark--mobile {
    display: block;
    width: min(var(--mobile-logo-width), 45vw);
  }
  .mobile-logo--left .wordmark--mobile { justify-self: start; }
  .mobile-logo--center .wordmark--mobile { justify-self: center; }
  .mobile-logo--right .wordmark--mobile { justify-self: end; }
}

/* Alignment settings position header marks across the full header, not just a grid cell. */
.site-header .wordmark--desktop {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}
.site-header--logo-left .wordmark--desktop { left: var(--pad); right: auto; }
.site-header--logo-center .wordmark--desktop { left: 50%; right: auto; transform: translate(-50%, -50%); }
.site-header--logo-right .wordmark--desktop { left: auto; right: var(--pad); }
.hero__logo-align--left .hero__logo { margin-right: auto; margin-left: 0; }
.hero__logo-align--center .hero__logo { margin-right: auto; margin-left: auto; }
.hero__logo-align--right .hero__logo { margin-right: 0; margin-left: auto; }

@media (max-width: 749px) {
  .site-header .wordmark--mobile {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .mobile-logo--left .wordmark--mobile { left: var(--pad); right: auto; }
  .mobile-logo--center .wordmark--mobile { left: 50%; right: auto; transform: translate(-50%, -50%); }
  .mobile-logo--right .wordmark--mobile { left: auto; right: var(--pad); }
  .mobile-logo--left [data-menu-toggle] {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .mobile-logo--right .header-actions {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
}
