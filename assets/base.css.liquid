:root{--bg:{{ settings.color_bg }};--ink:{{ settings.color_ink }};--muted:{{ settings.color_muted }};--accent:{{ settings.color_accent }};--heading:{{ settings.heading_font.family }},sans-serif;--body:{{ settings.body_font.family }},sans-serif;--pad:clamp(18px,3vw,48px)}
