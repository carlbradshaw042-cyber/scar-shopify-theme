ontent{position:absolute;z-index:1;padding:var(--pad);max-width:1100px}.hero__content--bottom-left{left:0;bottom:0}.hero__content--center{inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.hero h1{font-size:clamp(48px,10vw,154px);max-width:9ch;margin-bottom:28px}.eyebrow{font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;margin-bottom:16px}.button{min-height:52px;padding:0 24px;background:var(--ink);color:var(--bg);border:1px solid var(--ink);display:inline-flex;align-items:center;justify-content:space-between;text-transform:uppercase;font-weight:bold;letter-spacing:.1em;font-size:11px;transition:.2s ease}.button:hover{background:var(--accent);border-color:var(--accent);color:#fff}.button--light{background:#fff;color:#111;border-color:#fff}.section-pad{padding:clamp(70px,10vw,150px) var(--pad)}.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:clamp(35px,6vw,80px);gap:30px}.section-head h2{margin-bottom:0}.section-head>a{text-transform:uppercase;font-size:11px;letter-spacing:.12em}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(36px,5vw,80px) 1px}.product-card{min-width:0}.product-card__media{display:block;position:relative;background:#e7e6e2;overflow:hidden;aspect-ratio:4/5}.product-card__media img,.product-card>svg{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1),opacity .35s}.product-card__second{position:absolute;inset:0;opacity:0}.product-card__media:hover img:first-child{transform:scale(1.025)}.product-card__media:hover .product-card__second{opacity:1}.product-card__meta{display:flex;justify-content:space-between;gap:20px;padding:16px 6px 0;text-transform:uppercase;font-size:11px;letter-spacing:.07em}.product-card__meta h3{font-size:inherit;letter-spacing:inherit;margin:0}.price s{margin-left:8px;color:var(--muted)}.newsletter{background:#101010;color:#f8f8f6;display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:end}.newsletter h2{font-size:clamp(58px,8vw,120px);margin-bottom:20px}.newsletter__form{border-bottom:1px solid #aaa;display:grid;grid-template-columns:1fr auto}.newsletter__form input{background:transparent;border:0;padding:18px 0;color:#fff;outline:none}.newsletter__form button{border:0;background:none;color:#fff;text-transform:uppercase;letter-spacing:.12em}.newsletter__form p,.newsletter__form ul{grid-column:1/-1}.footer{background:#101010;color:#fff;border-top:1px solid #333;padding-top:60px;padding-bottom:30px}.footer__brand{font:bold clamp(92px,23vw,360px)/.75 var(--heading);letter-spacing:-.09em;display:block;margin-bottom:80px}.footer nav{display:flex;flex-wrap:wrap;gap:22px 42px;text-transform:uppercase;font-size:11px;letter-spacing:.12em}.footer__bottom{display:flex;justify-content:space-between;margin-top:80px;color:#999;font-size:10px;text-transform:uppercase}.footer select{background:#101010;border:0}.product{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(350px,1fr);align-items:start}.product__gallery{display:grid;grid-template-columns:1fr 1fr;gap:1px}.product__media{margin:0;background:#e6e5e1}.product__media img{height:100%;object-fit:cover}.product__info{position:sticky;top:0;padding:clamp(40px,6vw,90px) var(--pad)}.product__info h1{font-size:clamp(42px,5vw,76px);margin-bottom:20px}.product__info>.price{display:block;font-size:15px;margin-bottom:42px}.variant-field{border:0;padding:0;margin:36px 0}.variant-field legend,.product-form>label{font-size:10px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:12px}.variant-buttons{display:flex;flex-wrap:wrap;gap:7px}.variant-buttons label{min-width:52px;padding:13px;border:1px solid #999;text-align:center;text-transform:uppercase}.variant-buttons input:checked+label{background:var(--ink);color:var(--bg);border-color:var(--ink)}.variant-buttons input:focus-visible+label{outline:2px solid var(--accent);outline-offset:2px}.quantity{display:block;width:72px;padding:10px;border:1px solid #999;background:transparent}.shipping-note{font-size:12px;margin:28px 0;display:flex;gap:9px}.shipping-note span{width:7px;height:7px;border-radius:100%;background:var(--accent);margin-top:5px;flex:none}.add-button{width:100%;position:relative}.add-button span:last-child{margin-left:25px}.add-button:disabled{background:#777;border-color:#777}.dynamic-checkout{margin-top:10px}.product-detail{border-top:1px solid #aaa}.product-detail:last-child{border-bottom:1px solid #aaa}.product-detail summary{padding:22px 0;display:flex;justify-content:space-between;text-transform:uppercase;font-size:11px;letter-spacing:.1em;cursor:pointer;list-style:none}.product-detail[open] summary span{transform:rotate(45deg)}.product-detail .rte{padding-bottom:24px}.rte{max-width:70ch}.rte a{text-decoration:underline}.page-top{min-height:55vh}.collection-head{margin-bottom:80px}.narrow{max-width:900px;margin:auto}.contact-form{display:grid;gap:10px;margin-top:50px}.contact-form input,.contact-form textarea,.search-form input{background:transparent;border:1px solid #888;padding:15px}.contact-form .button{justify-self:start;margin-top:10px}.search-form{display:flex;max-width:700px;margin:40px 0 80px}.search-form input{flex:1}.search-result{padding:35px;border-top:1px solid #aaa}.pagination{text-align:center;margin-top:80px}.drawer{position:fixed;inset:0;z-index:100;visibility:hidden;transition:visibility .3s}.drawer[aria-hidden=false]{visibility:visible}.drawer__scrim{position:absolute;inset:0;background:rgba(0,0,0,.5);border:0;opacity:0;transition:opacity .3s}.drawer[aria-hidden=false] .drawer__scrim{opacity:1}.drawer__panel{position:absolute;right:0;top:0;height:100%;width:min(500px,100%);background:var(--bg);padding:28px;transform:translateX(100%);transition:transform .35s cubic-bezier(.2,.7,.2,1);overflow:auto}.drawer[aria-hidden=false] .drawer__panel{transform:none}.drawer__panel header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #aaa;padding-bottom:20px}.drawer__panel h2{font-size:28px;margin:0}.cart-item{display:grid;grid-template-columns:110px 1fr;gap:20px;padding:22px 0;border-bottom:1px solid #bbb}.cart-item small,.cart-item span{display:block;margin:5px 0}.cart-item input{width:50px;background:transparent;border:1px solid #999}.drawer__footer{padding-top:30px}.drawer__footer p{display:flex;justify-content:space-between}.drawer__footer .button{width:100%}.reveal{opacity:0;transform:translateY(16px);transition:opacity .7s,transform .7s}.reveal.is-visible{opacity:1;transform:none}
@media(max-width:749px){.site-header{height:76px;grid-template-columns:1fr auto 1fr}.mobile-only{display:block;text-align:left;font-size:10px}.desktop-nav{display:none}.header-actions>a{display:none}.wordmark{font-size:48px}.mobile-menu{display:flex;position:absolute;top:100%;left:0;right:0;background:var(--bg);padding:25px var(--pad);flex-direction:column;gap:18px;border-bottom:1px solid #aaa}.mobile-menu[hidden]{display:none}.hero--full{min-height:calc(100svh - 105px)}.hero__content{padding-bottom:34px}.product-grid{grid-template-columns:1fr;gap:55px}.product-card__meta{padding-left:0;padding-right:0}.section-head{align-items:start}.newsletter{grid-template-columns:1fr}.footer__bottom{gap:20px;flex-wrap:wrap}.product{display:block}.product__gallery{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.product__media{min-width:92vw;scroll-snap-align:start}.product__info{position:static}.add-button{position:fixed;z-index:30;left:12px;right:12px;bottom:12px;width:calc(100% - 24px);box-shadow:0 4px 22px rgba(0,0,0,.25)}.dynamic-checkout{margin-bottom:55px}.reveal{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}

/* Scar editorial system */
.wordmark{padding:var(--logo-space) 0}.wordmark--left{justify-self:start}.wordmark--center{justify-self:center}.wordmark--right{justify-self:end}.header-logo{width:min(var(--logo-desktop),40vw);height:auto}.header-logo--mobile{display:none}.site-header--overlay{position:absolute;top:29px;width:100%;background:transparent;color:#fff;border-color:rgba(255,255,255,.35)}.site-header--overlay.is-scrolled{position:fixed;top:0;background:var(--bg);color:var(--ink);border-color:rgba(0,0,0,.14)}
.hero{min-height:0;height:min(var(--hero-desktop),65vh)}.hero__placeholder,.editorial__placeholder{height:100%;display:grid;place-items:center;background:#242424;color:#ddd;text-transform:uppercase;letter-spacing:.14em;font-size:11px}.hero__content--bottom-right{right:0;bottom:0;text-align:right}.hero__logo{margin-bottom:var(--hero-logo-space)}.hero__logo img{width:min(var(--hero-logo-desktop),80vw);height:auto}.hero__logo--center img{margin:auto}.hero__logo--right img{margin-left:auto}
.featured{padding-top:var(--section-top);padding-bottom:var(--section-bottom)}.featured .product-grid{grid-template-columns:repeat(var(--columns,4),minmax(0,1fr))}.product-card__media{aspect-ratio:var(--ratio,4 / 5)}.product-card__media img{object-fit:var(--fit,cover)}.product-card small{display:block;color:var(--muted);margin-top:5px;font-size:9px}.empty-state{grid-column:1/-1}
.editorial{position:relative;height:var(--editorial-height);margin-top:var(--editorial-top);margin-bottom:var(--editorial-bottom);overflow:hidden;color:#fff}.editorial__media,.editorial__media img{width:100%;height:100%;object-fit:cover}.editorial--left img{object-position:left}.editorial--right img{object-position:right}.editorial__content{position:absolute;inset:auto var(--pad) var(--pad);max-width:600px}.editorial__content h2{margin-bottom:12px}.editorial__content a,.size-guide-trigger{text-transform:uppercase;letter-spacing:.12em;font-size:11px}.size-guide-trigger{border:0;border-bottom:1px solid;background:none;padding:12px 0;margin:16px 0 28px}.size-guide .drawer__panel>.rte,.size-guide .drawer__panel>img{margin-top:24px}.drawer-logo{padding-bottom:var(--drawer-logo-space);text-align:var(--drawer-logo-alignment,left)}.drawer-logo img{width:var(--drawer-logo-width);height:auto}.drawer-logo--center img{margin:auto}.drawer-logo--right img{margin-left:auto}
.footer__brand{font-size:initial;letter-spacing:normal;margin-bottom:var(--footer-logo-space)}.footer__brand img{width:min(var(--footer-logo-desktop),100%);height:auto}.footer__brand span{font:bold clamp(92px,23vw,360px)/.75 var(--heading);letter-spacing:-.09em}.footer__brand--center img{margin:auto}.footer__brand--right img{margin-left:auto}.footer-newsletter{max-width:520px;margin-top:50px}.footer-newsletter div{display:flex;border-bottom:1px solid #777}.footer-newsletter input{flex:1;background:none;border:0;color:#fff;padding:15px 0}.footer-newsletter button{background:none;border:0;color:#fff}.payment-icons{display:flex;gap:6px;flex-wrap:wrap}.payment-icons svg{width:38px;height:24px}
@media(max-width:1100px) and (min-width:750px){.featured .product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:749px){.header-logo--desktop{display:none}.header-logo--mobile{display:block;width:min(var(--logo-mobile),42vw)}.site-header--overlay{top:29px}.hero{height:min(var(--hero-mobile),55vh)}.hero__logo img{width:min(var(--hero-logo-mobile),80vw)}.featured .product-grid,.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:44px 1px}.product-card__meta{display:block}.product-card__meta>.price{margin-top:6px}.drawer-logo img{width:var(--drawer-logo-mobile)}.footer__brand img{width:min(var(--footer-logo-mobile),100%)}.editorial{min-height:420px}.editorial__content h2{font-size:38px}}
@media(hover:none){.product-card__second{display:none}}
